# Copy to .env (git-ignored). Read by the server (`pnpm dev`) and by `docker compose`.

# coturn's shared secret; the server mints TURN credentials with it. `openssl rand -hex 32`
TURN_SECRET=

# Defaults, shown for reference:
TURN_URLS=stun:127.0.0.1:3478,turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
TURN_TTL_SECONDS=14400
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# WORKERS=                     # mediasoup Workers; default: CPU cores - 1
# MEDIA_LISTEN_IP=127.0.0.1    # 0.0.0.0 in containers, then also:
# MEDIA_ANNOUNCED_ADDRESS=     # public IP or hostname put in ICE candidates
# MEDIA_PORT_BASE=40000        # Worker i: UDP+TCP port MEDIA_PORT_BASE + i
# ALLOW_LOOPBACK=              # SFU loopback test; default true except NODE_ENV=production

# Postgres: accounts and durable rooms. `docker compose up -d postgres`; the default is compose.yaml's.
# DATABASE_URL=postgres://ts_rtc:ts_rtc@127.0.0.1:5432/ts_rtc
# Signs access tokens; required in production. `openssl rand -hex 32`
# JWT_SECRET=
# AUTH_RATE_PER_MINUTE=10      # sign-up and sign-in attempts per client IP and minute
# TEST_DATABASE_URL=postgres://ts_rtc:ts_rtc@127.0.0.1:5432/ts_rtc   # enables test/db.test.ts
